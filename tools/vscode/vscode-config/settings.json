{
  "workbench.startupEditor": "none",
  "extensions.ignoreRecommendations": true,
  "explorer.confirmDragAndDrop": false,
  "workbench.colorTheme": "Default Dark+",
  // "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "explorer.compactFolders": false,
  "git.openRepositoryInParentFolders": "always",
  "C_Cpp.default.includePath": ["~/.capt/root/usr/include"],
  //"[cpp]": {
  //  "editor.defaultFormatter": "ms-vscode.cpptools"
  //},
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*.c": "c",
    "*.h": "c",
    "*.cpp": "cpp",
    "*.hpp": "cpp"
  },
  "[snippets]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "git.enableSmartCommit": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "update.mode": "none",
  "C_Cpp.suggestSnippets": false,
  "explorer.confirmPasteNative": false,
  "workbench.iconTheme": "material-icon-theme",
  "makefile.configureOnOpen": false,
  "debug.onTaskErrors": "showErrors",
  "editor.minimap.enabled": false,
  //"explorer.autoReveal": false,
  "workbench.editor.enablePreview": true,
  "gitlens.currentLine.enabled": false,
  "gitlens.codeLens.enabled": false,
  "chat.commandCenter.enabled": false,
  "clang-format.executable": "/home/akovtune/.capt/root/usr/bin/clang-format",
  //"clang-format.style": "Microsoft",
  //"clang-format.style": "Google",
  "clang-format.style": "file",
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "testMate.cpp.test.advancedExecutables": [
    {
      "pattern": "**/runtests",
      "runTask": {
        "before": ["build-tests"]
      }
    }
  ],
  //"testMate.cpp.test.executables": "**/runtests"
  //"testMate.cpp.test.executables": "**/tests/**/*.test.cpp"
  //"testMate.cpp.test.executables": "{build,Build,BUILD,out,Out,OUT}/**/*{test,Test,TEST}*"
  "redhat.telemetry.enabled": false,
  "yaml.schemas": {
    "https://json.schemastore.org/clang-format.json": [".clang-format"]
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  }
}
