	"Create ft_strlen function": {
		"scope": "c",
		"prefix": "gsl",
		"body": [
			"int\tft_strlen(char *str)",
			"{",
			"\tint\ti;",
			"",
			"\tif (!str)",
			"\t\treturn (0);",
			"\ti = 0;",
			"\twhile (str[i])",
			"\t\ti++;",
			"\treturn (i);",
			"}",
		],
		"description": "Creates a ft_strlen function"
	},
	"Create index_of function": {
		"scope": "c",
		"prefix": "ftiof",
		"body": [
			"int\tindex_of(char c, char *str)",
			"{",
			"\tint\ti;",
			"",
			"\tif (!str)",
			"\t\treturn (-1);",
			"\ti = -1;",
			"\twhile (str[++i])",
			"\t\tif (str[i] == c)",
			"\t\t\treturn (i);",
			"\treturn (-1);",
			"}",
		],
		"description": "Creates a index_of function"
	},
	"Create ft_strcmp function": {
		"scope": "c",
		"prefix": "ftcmp",
		"body": [
			"int\tft_strcmp(char *s1, char *s2)",
			"{",
			"\tint\ti;",
			"",
			"\ti = -1;",
			"\twhile (s1[++i] && s2[i])",
			"\t\tif (s1[i] != s2[i])",
			"\t\t\treturn (s1[i] - s2[i]);",
			"\treturn (s1[i] - s2[i]);",
			"}"
		],
		"description": "Creates a ft_strcmp function"
	},
