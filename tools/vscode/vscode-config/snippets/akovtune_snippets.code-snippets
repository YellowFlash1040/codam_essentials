	"Create basic Makefile": {
		"prefix": "mkfl",
		"body": [
			"#-----------------------COMPILATION------------------------------------------------------",
			"# Compiler and Flags",
			"CC\t\t\t\t\t\t:= cc",
			"CFLAGS\t\t\t\t \t = -Wall -Wextra -Werror $(INCLUDES) -g",
			"LDFLAGS\t\t\t\t\t:= -lsome_external_lib",
			"INCLUDES\t\t\t\t = $(addprefix -I,$(SRC_DIRS)) $(addprefix -I,$(LIB_DIRS))",
			"",
			"#-----------------------BINARIES---------------------------------------------------------",
			"# Output Files",
			"NAME\t\t\t\t\t:= name",
			"NAMELIB\t\t\t\t\t:= libname.a",
			"",
			"#-----------------------FOLDERS----------------------------------------------------------",
			"# Directories",
			"SRC_DIR\t\t\t\t\t:= src",
			"OBJ_DIR\t\t\t\t\t:= obj",
			"LIB_DIR \t\t\t\t:= libraries",
			"",
			"# Source directories (src/)",
			"SOME_SRC_DIR\t\t\t:= $(SRC_DIR)/some_src_dir",
			"",
			"# List of all source directories",
			"SRC_DIRS\t\t\t\t:= $(SRC_DIR)",
			"",
			"# Library directories (libraries/)",
			"SOME_LIB_DIR\t\t\t:= $(LIB_DIR)/somelib",
			"",
			"# List of all library directories",
			"LIB_DIRS\t\t\t\t:= $(SOME_LIB_DIR)",
			"",
			"#-----------------------FILES------------------------------------------------------------",
			"# Sources",
			"C_FILES \t\t\t\t:= $(foreach dir,$(SRC_DIRS),$(wildcard $(dir)/*.c))",
			"HEADERS \t\t\t\t:= $(foreach dir,$(SRC_DIRS),$(wildcard $(dir)/*.h))",
			"",
			"# Objects",
			"OBJ     \t\t\t\t:= $(patsubst %.c, $(OBJ_DIR)/%.o, $(notdir $(C_FILES)))",
			"",
			"#-----------------------LIBRARIES--------------------------------------------------------",
			"# Library files",
			"SOME_LIB\t\t\t\t:= $(SOME_LIB_DIR)/somelib.a",
			"",
			"# Libraries",
			"LIBRARIES\t\t\t\t:= $(SOME_LIB)",
			"",
			"#-----------------------COLORS-----------------------------------------------------------",
			"# Colors for Output",
			"GREEN\t\t\t\t\t:= \\033[0;32m",
			"RED\t\t\t\t\t\t:= \\033[31m",
			"RESET\t\t\t\t\t:= \\033[0m",
			"",
			"#-----------------------RULES------------------------------------------------------------",
			"vpath %.c $(SRC_DIRS)",
			"vpath %.h $(SRC_DIRS)",
			"",
			"# Default Target",
			"all: $(NAME)",
			"",
			"# Build the Executable",
			"$(NAME): $(OBJ) $(LIBRARIES)",
			"\t@$(CC) $(CFLAGS) $^ $(LDFLAGS) -o $@",
			"\t@echo \"$(GREEN)Compiled $@ successfully!$(RESET)\"",
			"",
			"# Compile Object Files",
			"$(OBJ_DIR)/%.o: %.c $(HEADERS)",
			"\t@mkdir -p $(OBJ_DIR)",
			"\t@$(CC) $(CFLAGS) -c $< -o $@",
			"",
			"# Compile libraries",
			"%.a:",
			"\t@cd $(dir $@); $(MAKE) > /dev/null; $(MAKE) clean > /dev/null",
			"",
			"# Build library from source",
			"$(NAMELIB): $(OBJ) $(LIBRARIES)",
			"\t@for lib in $(LIBRARIES); do \\",
			"\t\tar x $$lib ; \\",
			"\t\tar src $@ *.o ; \\",
			"\t\trm *.o ; \\",
			"\tdone",
			"\t@ar src $@ $(OBJ)",
			"\t@ar d $@ main.o",
			"",
			"# Clean up Object Files",
			"clean:",
			"\t@rm -rf $(OBJ_DIR)",
			"\t@echo \"$(RED)Removed object files$(RESET)\"",
			"\t@for lib in $(LIB_DIR)/*; do \\",
			"\t\t$(MAKE) -C $$lib clean > /dev/null; \\",
			"\tdone",
			"",
			"# Clean up All Generated Files",
			"fclean: clean",
			"\t@rm -rf $(NAME)",
			"\t@echo \"$(RED)Removed $(NAME)$(RESET)\"",
			"\t@for lib in $(LIB_DIR)/*; do \\",
			"\t\t$(MAKE) -C $$lib fclean > /dev/null; \\",
			"\tdone",
			"",
			"# Rebuild the Project",
			"re: fclean all",
			"",
			"# Phony Targets",
			".PHONY: all clean fclean re",
			""
		],
		"description": "Creates a basic Makefile"
	},
